+    @BeforeEach
+    fun setUp() {
+        mockContext = mockk(relaxed = true)
+        mockAlarmManager = mockk(relaxed = true)
+        mockIntent = mockk(relaxed = true)
+        mockPendingIntent = mockk(relaxed = true)
+
+        capturedRequestCode = null
+        capturedFlags = null
+        capturedTargetClass = null
